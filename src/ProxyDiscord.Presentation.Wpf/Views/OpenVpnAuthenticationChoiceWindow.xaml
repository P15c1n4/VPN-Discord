<Window x:Class="ProxyDiscord.Presentation.Wpf.Views.OpenVpnAuthenticationChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autenticação OpenVPN"
        Width="520" Height="320" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Escolha como autenticar"
                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <StackPanel Grid.Row="1">
            <TextBlock x:Name="SituationText" TextWrapping="Wrap"/>
            <TextBlock x:Name="AvailabilityText" TextWrapping="Wrap" Margin="0,10,0,0"
                       Style="{StaticResource SecondaryTextStyle}"/>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancelar" HorizontalAlignment="Left" MinWidth="90"
                    IsCancel="True"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ProfileButton" Content="Usar credenciais do perfil"
                        Click="UseProfile_Click" Margin="0,0,8,0"/>
                <Button x:Name="LocalButton" Content="Usar login local"
                        Click="UseLocal_Click" Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
