<UserControl x:Class="ProxyDiscord.Presentation.Wpf.Views.PasswordField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <PasswordBox x:Name="HiddenInput" PasswordChanged="HiddenInput_Changed"
                     AutomationProperties.Name="Senha"/>
        <TextBox x:Name="VisibleInput" Visibility="Collapsed" TextChanged="VisibleInput_Changed"
                 SpellCheck.IsEnabled="False" AutomationProperties.Name="Senha visível"/>
        <Button x:Name="RevealButton" Grid.Column="1" Content="Mostrar" MinWidth="64" Margin="6,0,0,0"
                Padding="6,4" Click="Reveal_Click" AutomationProperties.Name="Mostrar ou ocultar senha"/>
    </Grid>
</UserControl>
