<Window x:Class="ProxyDiscord.Presentation.Wpf.Views.SavedCredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProxyDiscord.Presentation.Wpf.Views"
        Title="Senhas salvas" Width="720" Height="450" MinWidth="540" MinHeight="350"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Credenciais por servidor" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12"/>
        <DataGrid x:Name="EntriesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single" SelectionChanged="Selection_Changed"
                  HeadersVisibility="Column" Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Servidor" Binding="{Binding ServerKey}" Width="*" MinWidth="240">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding ServerKey}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Usuário" Binding="{Binding Username}" Width="160">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Username}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2">
            <TextBlock Text="Senha do servidor selecionado" Style="{StaticResource SecondaryTextStyle}"/>
            <local:PasswordField x:Name="SavedPassword" IsReadOnly="True" IsEnabled="False" Margin="0,4,0,8"/>
            <TextBlock Text="Para alterar a senha, digite-a na tela principal e conecte ao servidor."
                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="3" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="DeleteButton" Content="Excluir selecionada" Click="Delete_Click" IsEnabled="False" Margin="0,0,8,0"/>
                <Button x:Name="ClearButton" Content="Excluir todas" Click="Clear_Click" IsEnabled="False"/>
            </StackPanel>
            <Button Content="Fechar" IsCancel="True" HorizontalAlignment="Right" MinWidth="90"/>
        </Grid>
    </Grid>
</Window>
