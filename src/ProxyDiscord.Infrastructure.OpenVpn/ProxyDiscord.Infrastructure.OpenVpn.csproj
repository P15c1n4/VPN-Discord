<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProxyDiscord.Application\ProxyDiscord.Application.csproj" />
    <ProjectReference Include="..\ProxyDiscord.Domain\ProxyDiscord.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProxyDiscord.Infrastructure.OpenVpn.Tests" />
  </ItemGroup>

  <!--
    The vendored OpenVPN client, its OpenSSL DLLs and the TAP driver package, copied under an
    "openvpn\" folder next to the app. OpenVpnBinaries resolves them from there and never from a
    system-wide OpenVPN installation, so the app behaves the same on a machine that has OpenVPN
    installed and on one that does not.
  -->
  <ItemGroup>
    <None Include="..\..\vendor\openvpn\bin\*.*">
      <Link>openvpn\bin\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
    <None Include="..\..\vendor\openvpn\driver\*.*">
      <Link>openvpn\driver\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
    <None Include="..\..\vendor\openvpn\LICENSE.txt">
      <Link>openvpn\LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

</Project>
